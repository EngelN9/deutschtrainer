# Public mobile/admin settings
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_CONTENT_SOURCE=api
EXPO_PUBLIC_GUEST_TRIAL_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_LEARNER_WEB_URL=http://localhost:8081
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only settings. Never expose these in mobile or browser bundles.
APP_ENV=local
HOST=127.0.0.1
PORT=8787
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_EVALUATION_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TIMEOUT_MS=20000
OPENAI_INPUT_COST_PER_MILLION=1
OPENAI_OUTPUT_COST_PER_MILLION=6
AI_DAILY_FREE_LIMIT=5
AI_WRITING_DAILY_FREE_LIMIT=2
AI_AUDIO_TTS_DAILY_FREE_LIMIT=5
AI_AUDIO_TRANSCRIPTION_DAILY_FREE_LIMIT=2
AI_CONTENT_GENERATION_DAILY_FREE_LIMIT=20
AI_PUBLIC_ENABLED=false
AI_GLOBAL_DAILY_PROVIDER_CALL_LIMIT=100
LEARNING_API_REQUESTS_PER_MINUTE=60
# Phase 0 virtual classroom is disabled by default and restricted to explicit learner profiles.
CLASSROOM_ENABLED=false
CLASSROOM_ALLOWED_PROFILE_IDS=
# Server-enforced session budget. The client countdown is UX only; these are the real limits.
CLASSROOM_MAX_SESSION_SECONDS=900
CLASSROOM_DAILY_SESSION_LIMIT=2
CLASSROOM_GLOBAL_DAILY_SESSION_LIMIT=3
CLASSROOM_SWEEP_INTERVAL_MS=30000
OPENAI_REALTIME_MODEL=gpt-realtime-mini-2025-12-15
OPENAI_SAFETY_IDENTIFIER_SALT=replace-with-server-only-salt
# Deterministic local fixture only. Never enable this in production.
AI_EVALUATION_FAKE_MODE=false
STORAGE_AUDIO_BUCKET=audio-assets
