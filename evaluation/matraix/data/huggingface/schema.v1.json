    },
    "prompt_version": {
      "const": "1.0.0",
      "title": "Prompt Version",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^dt-(B1|B2|C1|C2)-[a-z0-9-]+-v1$",
