{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTENT_SOURCE": "mock"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "DEUTSCHTRAINER_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_CONTENT_SOURCE": "api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "DEUTSCHTRAINER_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_CONTENT_SOURCE": "api"
      }
    }
  }
}
